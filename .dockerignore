# Ignore local compilation artifacts (prevents Mac/Windows/Linux mismatches)
target/

# Ignore cargo credentials and local registry overrides
.cargo/

# Ignore git history to keep the build context lightweight
.git/
.gitignore

# Ignore local environment variables and secrets
.env
*.env

# Ignore IDE specific setups
.vscode/
.idea/

# Ignore Docker files themselves
Dockerfile
docker-compose.yml
.dockerignore
