{
    "show_completions_on_input": true,
    "show_completion_documentation": false,
    "show_edit_predictions": false,
    "lsp": {
        "rust-analyzer": {
            "initialization_options": {
                "cargo": {
                    "features": "all",
                    "autoreload": true,
                    "targetDir": true,
                },
                "procMacro": {
                    "enable": true,
                },
                "check": {
                    "workspace": true,
                    "allTargets": true,
                },
                "rust": {
                  "analyzerTargetDir": true
                }
            },
        },
    },
}
