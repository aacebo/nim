          "rawSql": "SELECT\n    r.id::text AS artifact_id,\n    r.name,\n    jsonb_pretty(r.content) AS content,\n    r.summary,\n    l.created_at AS linked_at,\n    r.created_at,\n    r.updated_at\nFROM artifacts_tasks l\nJOIN artifacts r ON r.id = l.artifact_id\nWHERE l.task_id::text = ${task:sqlstring}\nORDER BY l.created_at DESC, r.id\nLIMIT 200"
