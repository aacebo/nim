{
  "uid": "nim-service-mesh",
  "title": "NIM Service Mesh",
  "description": "Trace-derived traffic between NIM services. Edges represent observed operations, not network-level connections. Metrics begin when Alloy receives correlated spans; idle services may not appear. Connections are colored by transport: NATS blue, HTTP orange, Unknown/other gray.",
  "tags": [
    "nim",
    "observability",
    "service-graph"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "timezone": "browser",
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "Service Traffic Flow",
      "description": "Edge hover shows HTTP/NATS and request rate. HTTP clients is an aggregate ingress node derived from actual gateway HTTP server spans. Click an edge for details. Individual requests are listed below.",
      "type": "nodeGraph",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 15
      },
      "targets": [
        {
          "refId": "edges",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "label_replace(label_replace(label_replace(label_replace(label_replace(label_join(label_replace(label_replace((sum by (client, server, transport) (label_replace(label_replace(label_replace(rate(traces_spanmetrics_calls_total{span_kind=\"SPAN_KIND_CONSUMER\",span_name=\"signal.process\",service_name=~\"nim-.*\",nim_signal_source=~\"nim-.+\"}[$__range]), \"client\", \"$1\", \"nim_signal_source\", \"(.+)\"), \"server\", \"$1\", \"service_name\", \"(.+)\"), \"transport\", \"nats\", \"__name__\", \".*\")) or label_replace(label_replace(label_replace(sum(rate(traces_spanmetrics_calls_total{service_name=\"nim-gateway\",span_kind=\"SPAN_KIND_SERVER\",span_name=\"http.request\"}[$__range])), \"client\", \"http-clients\", \"__name__\", \".*\"), \"server\", \"nim-gateway\", \"__name__\", \".*\"), \"transport\", \"http\", \"__name__\", \".*\")), \"color\", \"#5794F2\", \"__name__\", \".*\"), \"color\", \"#FF9830\", \"transport\", \"http\"), \"id\", \"|\", \"client\", \"server\", \"transport\"), \"source\", \"$1\", \"client\", \"(.+)\"), \"target\", \"$1\", \"server\", \"(.+)\"), \"mainstat\", \"NATS\", \"transport\", \"nats\"), \"mainstat\", \"HTTP\", \"transport\", \"http\"), \"detail__transport\", \"$1\", \"mainstat\", \"(.+)\")",
          "format": "table",
          "instant": true,
          "range": false
        },
        {
          "refId": "nodes",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "label_replace(sum by (id) (label_replace(sum by (service_name) (traces_spanmetrics_calls_total{span_kind=\"SPAN_KIND_CONSUMER\",span_name=\"signal.process\",service_name=~\"nim-.*\"}), \"id\", \"$1\", \"service_name\", \"(.+)\") or label_replace(sum by (nim_signal_source) (traces_spanmetrics_calls_total{span_kind=\"SPAN_KIND_CONSUMER\",span_name=\"signal.process\",service_name=~\"nim-.*\",nim_signal_source=~\"nim-.+\"}), \"id\", \"$1\", \"nim_signal_source\", \"(.+)\") or label_replace(sum(traces_spanmetrics_calls_total{service_name=\"nim-gateway\",span_kind=\"SPAN_KIND_SERVER\",span_name=\"http.request\"}), \"id\", \"nim-gateway\", \"__name__\", \".*\") or label_replace(sum(traces_spanmetrics_calls_total{service_name=\"nim-gateway\",span_kind=\"SPAN_KIND_SERVER\",span_name=\"http.request\"}), \"id\", \"http-clients\", \"__name__\", \".*\")), \"title\", \"$1\", \"id\", \"(.+)\")",
          "format": "table",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "edges": {
          "secondaryStatUnit": "reqps"
        }
      },
      "transformations": [
        {
          "id": "calculateField",
          "filter": {
            "id": "byRefId",
            "options": "edges"
          },
          "options": {
            "mode": "reduceRow",
            "reduce": {
              "reducer": "sum",
              "include": [
                "Value",
                "Value #edges"
              ]
            },
            "alias": "secondarystat",
            "replaceFields": false
          }
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "pattern": "^(id|source|target|title|subtitle|mainstat|secondarystat|detail__.*|color)$"
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "client": true,
              "server": true,
              "transport": true,
              "Value": true
            },
            "indexByName": {},
            "renameByName": {}
          }
        }
      ]
    },
    {
      "id": 2,
      "title": "Traffic By Connection",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (client, server, transport) (label_replace(label_replace(label_replace(rate(traces_spanmetrics_calls_total{span_kind=\"SPAN_KIND_CONSUMER\",span_name=\"signal.process\",service_name=~\"nim-.*\",nim_signal_source=~\"nim-.+\"}[$__rate_interval]), \"client\", \"$1\", \"nim_signal_source\", \"(.+)\"), \"server\", \"$1\", \"service_name\", \"(.+)\"), \"transport\", \"nats\", \"__name__\", \".*\"))",
          "legendFormat": "{{client}} \u2192 {{server}} [{{transport}}]",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 3,
      "title": "Error Rate By Connection",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 17,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum by (client, server, transport) (label_replace(label_replace(label_replace(rate(traces_spanmetrics_calls_total{span_kind=\"SPAN_KIND_CONSUMER\",span_name=\"signal.process\",service_name=~\"nim-.*\",nim_signal_source=~\"nim-.+\",status_code=\"STATUS_CODE_ERROR\"}[$__rate_interval]), \"client\", \"$1\", \"nim_signal_source\", \"(.+)\"), \"server\", \"$1\", \"service_name\", \"(.+)\"), \"transport\", \"nats\", \"__name__\", \".*\")) or 0 * sum by (client, server, transport) (label_replace(label_replace(label_replace(rate(traces_spanmetrics_calls_total{span_kind=\"SPAN_KIND_CONSUMER\",span_name=\"signal.process\",service_name=~\"nim-.*\",nim_signal_source=~\"nim-.+\"}[$__rate_interval]), \"client\", \"$1\", \"nim_signal_source\", \"(.+)\"), \"server\", \"$1\", \"service_name\", \"(.+)\"), \"transport\", \"nats\", \"__name__\", \".*\"))) / (sum by (client, server, transport) (label_replace(label_replace(label_replace(rate(traces_spanmetrics_calls_total{span_kind=\"SPAN_KIND_CONSUMER\",span_name=\"signal.process\",service_name=~\"nim-.*\",nim_signal_source=~\"nim-.+\"}[$__rate_interval]), \"client\", \"$1\", \"nim_signal_source\", \"(.+)\"), \"server\", \"$1\", \"service_name\", \"(.+)\"), \"transport\", \"nats\", \"__name__\", \".*\")) > 0)",
          "legendFormat": "{{client}} \u2192 {{server}} [{{transport}}]",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Failed requests divided by total requests. The axis is fixed at 0\u2013100%; idle connections have no rate."
    },
    {
      "id": 4,
      "title": "p95 Processing Latency By Connection",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 17,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, client, server, transport) (label_replace(label_replace(label_replace(rate(traces_spanmetrics_duration_seconds_bucket{span_kind=\"SPAN_KIND_CONSUMER\",span_name=\"signal.process\",service_name=~\"nim-.*\",nim_signal_source=~\"nim-.+\"}[$__rate_interval]), \"client\", \"$1\", \"nim_signal_source\", \"(.+)\"), \"server\", \"$1\", \"service_name\", \"(.+)\"), \"transport\", \"nats\", \"__name__\", \".*\")))",
          "legendFormat": "{{client}} \u2192 {{server}} [{{transport}}]",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 5,
      "title": "Transport Legend",
      "type": "text",
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 24,
        "h": 2
      },
      "options": {
        "mode": "html",
        "content": "<p><span style=\"color: #5794F2\">\u25cf NATS</span> &nbsp; <span style=\"color: #FF9830\">\u25cf HTTP</span> &nbsp; <span style=\"color: #8E8E8E\">\u25cf Unknown / other</span> &nbsp; Edge hover shows transport. HTTP clients aggregates inbound gateway requests; open a request trace below to inspect its publications.</p>"
      }
    },
    {
      "id": 6,
      "title": "Inbound HTTP Requests \u2014 Open A Trace To Inspect Triggered Publications",
      "type": "table",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "x": 0,
        "y": 25,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{ resource.service.name = \"nim-gateway\" && name = \"http.request\" }",
          "limit": 50,
          "tableType": "traces"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Trace ID"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "data-links"
                }
              },
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open Request And Publications",
                    "url": "/explore?schemaVersion=1&panes=%7B%22trace%22%3A%7B%22datasource%22%3A%22tempo%22%2C%22queries%22%3A%5B%7B%22refId%22%3A%22A%22%2C%22queryType%22%3A%22traceId%22%2C%22query%22%3A%22${__value.raw}%22%2C%22datasource%22%3A%7B%22type%22%3A%22tempo%22%2C%22uid%22%3A%22tempo%22%7D%7D%5D%2C%22range%22%3A%7B%22from%22%3A%22now-1h%22%2C%22to%22%3A%22now%22%7D%7D%7D",
                    "targetBlank": true
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true
      }
    }
  ],
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m",
      "5m",
      "15m",
      "30m",
      "1h"
    ]
  }
}
