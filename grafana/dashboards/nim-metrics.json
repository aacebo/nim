    {
      "id": 13,
      "title": "Current container resources",
      "description": "Current samples only; disappeared containers are removed after exporter expiration and the next scrape. Effective memory limits may reflect the Docker VM capacity when no explicit application limit is set.",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (compose_project, compose_service, container_name, container_id) (docker_container_cpu_usage_percent{job=\"nim-resources\",compose_service=~\"gateway|text|audio|vision|encode|sleep\",compose_service=~\"$service\"} and on() (up{job=\"nim-resources\"} == 1))",
          "legendFormat": "{{compose_service}} \u00b7 {{container_name}}",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (compose_project, compose_service, container_name, container_id) (docker_container_mem_usage{job=\"nim-resources\",compose_service=~\"gateway|text|audio|vision|encode|sleep\",compose_service=~\"$service\"} and on() (up{job=\"nim-resources\"} == 1))",
          "legendFormat": "{{compose_service}} \u00b7 {{container_name}}",
