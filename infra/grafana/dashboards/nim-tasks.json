{
  "uid": "nim-tasks",
  "title": "NIM Tasks",
  "description": "Browse the 200 most recently updated tasks and inspect status, output, events, parent/child tasks, and linked artifacts, messages, chats, and models. Select a task to inspect its details. Browsing is independent of the dashboard time range.",
  "tags": [
    "nim",
    "postgres",
    "tasks"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "timezone": "browser",
  "refresh": "5s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "links": [
    {
      "title": "All Tasks",
      "type": "link",
      "url": "/d/nim-tasks?var-task=all",
      "targetBlank": false
    }
  ],
  "templating": {
    "list": [
      {
        "name": "task",
        "label": "Task",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "postgres"
        },
        "query": "SELECT __text, __value FROM (\n    SELECT 'All tasks' AS __text, 'all' AS __value, 0 AS priority, NULL::timestamptz AS updated_at\n    UNION ALL\n    SELECT name || ' \u00b7 ' || id::text, id::text, 1, updated_at\n    FROM tasks\n) options\nORDER BY priority, updated_at DESC NULLS FIRST\nLIMIT 501",
        "definition": "SELECT __text, __value FROM (\n    SELECT 'All tasks' AS __text, 'all' AS __value, 0 AS priority, NULL::timestamptz AS updated_at\n    UNION ALL\n    SELECT name || ' \u00b7 ' || id::text, id::text, 1, updated_at\n    FROM tasks\n) options\nORDER BY priority, updated_at DESC NULLS FIRST\nLIMIT 501",
        "refresh": 1,
        "multi": false,
        "includeAll": false,
        "current": {
          "text": "All tasks",
          "value": "all"
        },
        "options": []
      }
    ]
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m",
      "5m",
      "15m",
      "30m",
      "1h"
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Tasks \u2014 Click task_id To Drill Down",
      "type": "table",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT\n    t.id::text AS task_id,\n    t.parent_id::text AS parent_id,\n    t.name,\n    t.status->>'status' AS status,\n    t.status->>'reason' AS error,\n    (SELECT COUNT(*) FROM task_events e WHERE e.task_id = t.id) AS events,\n    t.created_at,\n    t.updated_at\nFROM tasks t\nWHERE (${task:sqlstring} = 'all' OR t.id::text = ${task:sqlstring})\nORDER BY t.updated_at DESC, t.id\nLIMIT 200"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "task_id"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Inspect Task",
                    "url": "/d/nim-tasks?var-task=${__value.raw}",
                    "targetBlank": false
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "parent_id"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Inspect Task",
                    "url": "/d/nim-tasks?var-task=${__value.raw}",
                    "targetBlank": false
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      }
    },
    {
      "id": 2,
      "title": "Selected Task Status, Output And Source",
      "type": "table",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT\n    t.id::text AS task_id,\n    t.parent_id::text AS parent_id,\n    t.name,\n    t.version,\n    t.status->>'status' AS status,\n    t.status->>'started_at' AS started_at,\n    t.status->>'ended_at' AS ended_at,\n    t.status->>'reason' AS error,\n    jsonb_pretty(t.status->'output') AS output,\n    jsonb_pretty(t.status) AS status_details,\n    jsonb_pretty(t.source) AS source,\n    t.created_at,\n    t.updated_at\nFROM tasks t\nWHERE t.id::text = ${task:sqlstring}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "parent_id"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Inspect Task",
                    "url": "/d/nim-tasks?var-task=${__value.raw}",
                    "targetBlank": false
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      }
    },
    {
      "id": 3,
      "title": "Selected Task Events \u2014 Latest 500 In Stream Order",
      "type": "table",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT * FROM (\n    SELECT\n        e.id::text AS event_id,\n        e.content->>'type' AS type,\n        jsonb_pretty(e.content) AS content,\n        e.created_at\n    FROM task_events e\n    WHERE e.task_id::text = ${task:sqlstring}\n    ORDER BY e.created_at DESC, e.id DESC\n    LIMIT 500\n) events\nORDER BY created_at ASC, event_id ASC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": true
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      }
    },
