          "range": false,
          "format": "table"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (compose_project, compose_service, container_name, container_id) (docker_container_mem_limit{job=\"nim-resources\",compose_service=~\"gateway|text|audio|vision|encode|sleep\",compose_service=~\"$service\"} and on() (up{job=\"nim-resources\"} == 1))",
          "legendFormat": "{{compose_service}} \u00b7 {{container_name}}",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "noValue": "No data"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "CPU"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Memory"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bytes"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Effective Docker memory limit"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bytes"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "compose_service": 0,
              "container_name": 1,
              "container_id": 2,
              "compose_project": 3,
              "Value #A": 4,
              "Value #B": 5,
              "Value #C": 6
