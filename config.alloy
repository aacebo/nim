logging {
  level  = "error"
  format = "logfmt"
}

discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"

  filter {
    name   = "label"
    values = ["com.docker.compose.project=" + sys.env("COMPOSE_PROJECT_NAME")]
  }
}

discovery.relabel "containers" {
  targets = []

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "service_name"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "compose_service"
  }
}

loki.source.docker "containers" {
  host          = "unix:///var/run/docker.sock"
  targets       = discovery.docker.containers.targets
  relabel_rules = discovery.relabel.containers.rules
  forward_to    = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}

otelcol.receiver.otlp "local" {
  grpc {
    endpoint = "0.0.0.0:4317"
  }

  http {
    endpoint = "0.0.0.0:4318"
  }

  output {
    traces  = [otelcol.processor.transform.transport.input]
    metrics = [otelcol.processor.batch.local.input]
  }
}

otelcol.processor.transform "transport" {
  trace_statements {
    context = "span"
    statements = [
      `set(attributes["nim.transport"], "unknown")`,
      `set(attributes["nim.transport"], attributes["network.protocol.name"]) where attributes["network.protocol.name"] != nil and attributes["network.protocol.name"] != ""`,
      `set(attributes["nim.transport"], attributes["messaging.system"]) where attributes["messaging.system"] != nil and attributes["messaging.system"] != ""`,
    ]
  }

  output {
    traces = [otelcol.processor.batch.local.input]
  }
}

otelcol.processor.batch "local" {
  output {
    traces = [
      otelcol.exporter.otlp.tempo.input,
      otelcol.connector.servicegraph.local.input,
      otelcol.connector.spanmetrics.local.input,
    ]
    metrics = [otelcol.exporter.prometheus.local.input]
  }
}

otelcol.connector.servicegraph "local" {
  dimensions             = ["nim.transport"]
  metrics_flush_interval = "15s"

  store {
    ttl = "5m"
  }

  output {
    metrics = [otelcol.exporter.prometheus.local.input]
  }
}

otelcol.connector.spanmetrics "local" {
  namespace              = "traces.spanmetrics"
  metrics_flush_interval = "15s"

  histogram {
    unit = "s"

    explicit {}
  }

  output {
    metrics = [otelcol.exporter.prometheus.local.input]
  }
}

otelcol.exporter.otlp "tempo" {
  client {
    endpoint = "tempo:4317"

    tls {
      insecure = true
    }
  }
}

otelcol.exporter.prometheus "local" {
  forward_to = [prometheus.remote_write.local.receiver]
}

prometheus.remote_write "local" {
  endpoint {
    url = "http://prometheus:9090/api/v1/write"
  }
}
