{
  "uid": "nim-metrics",
  "title": "NIM Metrics",
  "description": "CPU, memory, network and block-device I/O for NIM gateway and worker containers.",
  "tags": [
    "nim",
    "resources",
    "docker"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "timezone": "browser",
  "refresh": "10s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m",
      "5m",
      "15m",
      "30m",
      "1h"
    ]
  },
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "custom",
        "query": "gateway,text,audio,vision,encode,sleep",
        "multi": true,
        "includeAll": true,
        "allValue": "gateway|text|audio|vision|encode|sleep",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": [
          {
            "text": "gateway",
            "value": "gateway",
            "selected": false
          },
          {
            "text": "text",
            "value": "text",
            "selected": false
          },
          {
            "text": "audio",
            "value": "audio",
            "selected": false
          },
          {
            "text": "vision",
            "value": "vision",
            "selected": false
          },
          {
            "text": "encode",
            "value": "encode",
            "selected": false
          },
          {
            "text": "sleep",
            "value": "sleep",
            "selected": false
          }
        ]
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "CPU \u00b7 100% = one core",
      "description": "",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(docker_container_cpu_usage_percent{job=\"nim-resources\",compose_service=~\"gateway|text|audio|vision|encode|sleep\",compose_service=~\"$service\"} and on() (up{job=\"nim-resources\"} == 1))",
          "legendFormat": "{{compose_service}} \u00b7 {{container_name}}",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
